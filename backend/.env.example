# Copy to .env and fill in. .env is gitignored — never commit real credentials.

KAIROS_ENVIRONMENT=local
KAIROS_DATABASE_URL=postgresql+psycopg://kairos:kairos@localhost:5432/kairos
KAIROS_REDIS_URL=redis://localhost:6379/0

# Added in M0 (ENG-01/02). Get them with: uv run python scripts/etsy_oauth.py
# The refresh token is the long-lived secret — rotate it, and never let it reach
# the repo or a log line. It expires after 90 days of not being used.
# KAIROS_ETSY_KEYSTRING=
# KAIROS_ETSY_SHARED_SECRET=
# KAIROS_ETSY_REFRESH_TOKEN=
# KAIROS_ETSY_USER_ID=
# KAIROS_ETSY_SHOP_ID=
